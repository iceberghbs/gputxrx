{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "sophnet-proxy": {
      "name": "SophNet Proxy",
      "canonical": "openai",
      "package": "@opencode/ai/providers/openai-compatible",
      "env": ["SOPHNET_API_KEY"],
      "settings": {
        "baseURL": "http://127.0.0.1:8899/v1",
        "transport": "http"
      },
      "models": {
        "GLM-5.3": {
          "name": "GLM 5.3 (proxied)"
        }
      }
    }
  }
}
